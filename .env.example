# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Neon pooled connection string (Neon dashboard → Connection Details)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any random string — signs the login session cookie
SESSION_SECRET="change-me-to-a-random-string"

# bcrypt hash of your chosen password, NOT the plaintext password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH="$2a$10$replace-with-a-real-bcrypt-hash"
